<ui:FluentWindow x:Class="M3URadioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="M3U Radio Player" Height="820" Width="680"
        WindowStartupLocation="CenterScreen"
        StateChanged="FluentWindow_StateChanged">
    
    <!-- 全体コンテナ: 最上段にタイトルバー、その下にメインコンテンツ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- タイトルバー（最小化・最大化・閉じる） -->
            <RowDefinition Height="*"/>
            <!-- メインコンテンツ -->
        </Grid.RowDefinitions>

        <!-- Windows 11 スタイルのタイトルバーとキャプションボタン -->
        <ui:TitleBar Grid.Row="0" Title="M3U Radio Player" />

        <!-- メインコンテンツ領域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 出力先設定カード -->
                <RowDefinition Height="Auto"/>
                <!-- 再生ステータスカード -->
                <RowDefinition Height="*"/>
                <!-- 放送局一覧 -->
                <RowDefinition Height="Auto"/>
                <!-- コントロールバー -->
            </Grid.RowDefinitions>

            <!-- 出力先設定カード -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="出力モード:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbOutputMode" Grid.Column="1" SelectionChanged="CmbOutputMode_SelectionChanged">
                            <ComboBoxItem Content="標準 (DirectSound / BASS Direct)" IsSelected="True"/>
                            <ComboBoxItem Content="ASIO"/>
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="出力デバイス:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbDevice" Grid.Column="1" SelectionChanged="CmbDevice_SelectionChanged"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 再生ステータスカード -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TxtStationName" Text="未再生" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtTrackTitle" Text="タイトル: ---" FontSize="14" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtStreamInfo" Text="形式: --- | サンプリングレート: ---" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <!-- 放送局一覧 -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="プレイリスト:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbPlaylist" Grid.Column="1" SelectionChanged="CmbPlaylist_SelectionChanged"/>
                    <ui:Button Grid.Column="2" Content="再読込" Margin="8,0,0,0" Click="BtnReload_Click"/>
                </Grid>

                <!-- リストビューと GridView のタグ構造 -->
                <ui:ListView x:Name="ListStations" Grid.Row="1" MouseDoubleClick="ListStations_MouseDoubleClick">
                    <ui:ListView.View>
                        <GridView>
                            <GridViewColumn Header="ステーション名" Width="240" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="ストリーム URL" Width="360" DisplayMemberBinding="{Binding Url}"/>
                        </GridView>
                    </ui:ListView.View>
                </ui:ListView>
            </Grid>

            <!-- 再生コントロール & 音量 -->
            <ui:Card Grid.Row="3" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button x:Name="BtnPlay" Grid.Column="0" Content="再生" Appearance="Primary" Width="90" Click="BtnPlay_Click"/>
                    <ui:Button x:Name="BtnStop" Grid.Column="1" Content="停止" Margin="8,0,16,0" Width="90" Click="BtnStop_Click"/>

                    <!-- 純粋ソフトウェア音量スライダー -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="音量:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SliderVolume" Width="130" Minimum="0" Maximum="1" Value="1.0"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="SliderVolume_ValueChanged"/>
                        <TextBlock x:Name="TxtVolume" Text="100%" Width="45" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>